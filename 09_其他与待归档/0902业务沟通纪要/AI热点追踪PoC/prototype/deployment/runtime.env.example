# 复制到服务器 /etc/ai-hotspot-poc/runtime.env 后填写真实值。
# 文件权限必须为 0640，所有密钥不得提交 Git。

AI_HOTSPOT_DATA_DIR=/var/lib/ai-hotspot-poc/data
AI_HOTSPOT_CONFIG_DIR=/var/lib/ai-hotspot-poc/config
AI_HOTSPOT_ADMIN_KEY=请生成独立管理员密钥
AI_HOTSPOT_KEY_ENCRYPTION_SECRET=请生成并固定保存的加密主密钥
AI_HOTSPOT_COOKIE_SECURE=true
AI_HOTSPOT_SESSION_HOURS=12

DOUBAO_SEARCH_API_KEY=请填写豆包GlobalSearch密钥

# 服务器直接运行 Codex CLI 时使用。若只用豆包，可保留路径但双路运行会显示Codex失败。
CODEX_CLI_PATH=/usr/local/bin/codex
CODEX_HOME=/var/lib/ai-hotspot-poc/codex-home
HOME=/var/lib/ai-hotspot-poc

# 可选：留空时使用服务器Codex默认模型。语义分析按事件顺序执行，单项最长240秒。
AI_HOTSPOT_CODEX_MODEL=
AI_HOTSPOT_CODEX_AI_TIMEOUT=240
AI_HOTSPOT_CODEX_AI_BATCH_SIZE=1
